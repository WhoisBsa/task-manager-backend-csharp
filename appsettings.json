{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "Messages": [
      {
        "MaxCall": 5,
        "BaseDelayMs": 500,
        "Exchange": "todos",
        "ExchangeType": "direct",
        "Queues": [
          {
            "QueueName": "send-todo-email",
            "RoutingKey": [
              "new-todo"
            ]
          }
        ]
      }
    ]
  }
}